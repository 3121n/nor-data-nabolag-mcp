{
  "name": "@nor-data/nabolag-mcp",
  "version": "0.2.1",
  "description": "MCP server for Norwegian neighborhood data: public-transport coverage (Entur), road-noise zones (Statens vegvesen), and green-area access (NIBIO + SSB). Open data, no API keys.",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "drist-nabolag-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LISTING.md"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/index.ts",
    "prepublishOnly": "npm run build"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "norway",
    "neighborhood",
    "real-estate",
    "transit",
    "noise",
    "green-space",
    "entur",
    "kollektivtransport",
    "stoy",
    "stoysone",
    "vegvesen",
    "nibio",
    "ssb",
    "nabolag"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/3121n/nor-data-nabolag-mcp.git"
  },
  "homepage": "https://github.com/3121n/nor-data-nabolag-mcp#readme",
  "bugs": {
    "url": "https://github.com/3121n/nor-data-nabolag-mcp/issues"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.4",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "@types/node": "^22.10.0"
  }
}